{
  "schemaVersion": 1,
  "id": "smoke-stub",
  "name": "Smoke test (stub modules)",
  "summary": "Engine test scenario. Stub modules only write and remove marker files.",
  "profileParameter": "Profile",
  "profiles": {
    "loud": { "Flag": true, "Mode": "a" },
    "subtle": { "Flag": false, "Mode": "b" }
  },
  "parameters": [
    { "name": "Profile", "type": "choice", "choices": ["loud", "subtle"], "default": "loud" },
    { "name": "Flag", "type": "bool", "default": true },
    { "name": "Mode", "type": "choice", "choices": ["a", "b"], "default": "a" }
  ],
  "steps": [
    { "id": "stage-script", "title": "Stub: stage", "module": "stub-stage-script" },
    { "id": "register-task", "title": "Stub: register", "module": "stub-register-scheduled-task", "dependsOn": ["stage-script"] },
    { "id": "task-executes", "title": "Stub: execute", "module": "stub-task-execution", "dependsOn": ["register-task"] }
  ]
}
